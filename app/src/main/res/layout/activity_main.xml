<?xml version="1.0" encoding="utf-8"?>
<!--
    Reto 1: Te han pedido clonar una aplicación. El equipo de desarrollo
    necesita que crees una pantalla exactamente igual que esta,
    sin necesidad de funcionalidad.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== TÍTULO ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejemplo de componentes Android"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- ===== COMPONENTES PARA MOSTRAR INFORMACIÓN ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Componentes para mostrar información"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Este texto se muestra mediante un TextView." />

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:contentDescription="Logo de Android"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Progreso: 50%" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="50" />

        <!-- VideoView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="VideoView"
            android:textStyle="bold" />

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="120dp"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/black" />

        <!-- WebView (dentro de un FrameLayout de altura fija para evitar el aviso de lint) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="WebView"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="8dp">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- ===== COMPONENTES DE ENTRADA E INTERACCIÓN ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Componentes de entrada e interacción"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Introduce tu nombre"
            android:inputType="textPersonName" />

        <!-- CheckBox -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selecciona tecnologías:"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbAndroid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android" />

        <CheckBox
            android:id="@+id/cbReact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="React" />

        <CheckBoxh
            android:id="@+id/cbFlutter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flutter" />

        <!-- RadioGroup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selecciona una modalidad:"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgModalidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/rbPresencial">

            <RadioButton
                android:id="@+id/rbPresencial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presencial" />

            <RadioButton
                android:id="@+id/rbOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online" />

            <RadioButton
                android:id="@+id/rbMixta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mixta" />
        </RadioGroup>

        <!-- Switch -->
        <Switch
            android:id="@+id/swNotificaciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Notificaciones" />

        <!-- Spinner (las opciones se cargan desde MainActivity.kt) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selecciona un curso:"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- SeekBar -->
        <TextView
            android:id="@+id/tvNivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nivel seleccionado: 50"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="50" />

        <!-- Botones -->
        <Button
            android:id="@+id/btnGuardar1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Guardar información" />

        <Button
            android:id="@+id/btnGuardar2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Guardar información" />

        <!-- Resultado -->
        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="Aquí aparecerá el resultado." />

    </LinearLayout>
</ScrollView>